# ============================================
# Environmental Monitoring Platform - Environment Configuration
# Copy to .env and fill in secure values
# ============================================

# -----------------------------------------------------------------------------
# MONGODB
# -----------------------------------------------------------------------------
MONGO_ROOT_PASSWORD=mongopass

# -----------------------------------------------------------------------------
# MOSQUITTO MQTT PASSWORDS (per-device)
# Generate with: mosquitto_passwd -c /mosquitto/config/passwd <username>
# Then for each user: mosquitto_passwd /mosquitto/config/passwd <username>
# -----------------------------------------------------------------------------
MOSQUITTO_BACKEND_PASSWORD=backendpass
MOSQUITTO_AI_PASSWORD=aipass
MOSQUITTO_DASHBOARD_PASSWORD=dashpass
MOSQUITTO_PROD_01_PASS=prod01pass
MOSQUITTO_PROD_02_PASS=prod02pass
MOSQUITTO_PROD_03_PASS=prod03pass
MOSQUITTO_STORE_01_PASS=store01pass
MOSQUITTO_STORE_02_PASS=store02pass
MOSQUITTO_TECH_01_PASS=tech01pass
MOSQUITTO_TECH_02_PASS=tech02pass

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# DASHBOARD
# -----------------------------------------------------------------------------
DASH_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# CORS ORIGINS (comma-separated, no spaces)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8050,http://localhost:8501,http://127.0.0.1:8050,http://127.0.0.1:8501

# -----------------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (for mobile push notifications)
# Get from Firebase Console > Project Settings > Cloud Messaging
# -----------------------------------------------------------------------------
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# -----------------------------------------------------------------------------
# TELEGRAM FALLBACK (for push notifications)
# Get from BotFather
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# DEVICE CERTIFICATES
# Generate with: ./infra/certs/generate_certs.sh
# Place in infra/certs/ca/, infra/certs/server/, infra/certs/client/
# -----------------------------------------------------------------------------
# CA_CERT_PATH=./infra/certs/ca/ca.crt
# SERVER_CERT_PATH=./infra/certs/server/server.crt
# SERVER_KEY_PATH=./infra/certs/server/server.key